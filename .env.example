# KBRS Django Backend Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Discord Integration
# ============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_API_BASE=https://discord.com/api

# Discord Channels
LEVEL_UP_LOG_CHANNEL_ID=1234567890123456789
ACHIVMENT_GET_LOG_CHANNEL_ID=1234567890123456789
ACHIEVEMENT_CHANNEL_ID=1428778218474835978
LEVEL_UP_PUBLIC_IN_SAME_CHANNEL=false

BIRTHDAY_CHANNEL_ID=1234567890123456789
BIRTHDAY_JA_CHANNEL_ID=0
BIRTHDAY_KO_CHANNEL_ID=0
BIRTHDAY_ZH_CHANNEL_ID=0

# ============================================================================
# AI Translation Service (DeepSeek)
# ============================================================================
DEEP_URL=https://api.intelligence.io.solutions/api/v1/chat/completions
DEEP_KEY=your_deepseek_api_key_here
DEEP_MODEL=deepseek-ai/DeepSeek-R1-0528

# ============================================================================
# Django Configuration
# ============================================================================
# Generate strong key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-super-secret-key-min-50-chars-recommended

# Environment
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Security
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
POSTGRES_DB=kbrs_db
POSTGRES_USER=kbrs_user
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=your_strong_postgres_password_min_32_chars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection pooling
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=true

# ============================================================================
# Celery (Task Queue)
# ============================================================================
# RabbitMQ Format: amqp://user:password@host:port/vhost
# Generate strong password: openssl rand -base64 24
CELERY_BROKER_URL=amqp://kbrs_user:your_rabbitmq_password@localhost:5672/kbrs_vhost
CELERY_RESULT_BACKEND=django-db

# Celery Configuration
CELERY_TIMEZONE=Asia/Seoul
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_ACKS_LATE=True

# ============================================================================
# Caching (Redis - Optional but Recommended)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=redis
CACHE_TTL=300

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs

# ============================================================================
# Security & Rate Limiting
# ============================================================================
# Enable security headers
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Rate limiting (requests per minute)
RATE_LIMIT_ANON=100
RATE_LIMIT_USER=1000
RATE_LIMIT_ENABLE=true

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true

# ============================================================================
# Email (Optional - for notifications)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=KBRS Bot <noreply@your-domain.com>

# ============================================================================
# Monitoring & Error Tracking (Optional)
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_API_DOCS=false
ENABLE_ADMIN_SITE=true
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true

# ============================================================================
# Performance
# ============================================================================
# Database query optimization
DB_DEBUG_QUERIES=false
DB_QUERY_LOG_THRESHOLD_MS=100

# Static files
USE_WHITENOISE=true
STATIC_ROOT=/var/www/kbrs/static
MEDIA_ROOT=/var/www/kbrs/media
